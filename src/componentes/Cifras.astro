---
/**
 * Los números suben desde cero cuando la franja entra en pantalla. El valor
 * final está escrito en el HTML: sin JavaScript se ve igual, quieto.
 */
const cifras = [
  { valor: 12, pie: "módulos sobre una misma base de datos" },
  { valor: 3, pie: "medios de recordatorio" },
  { valor: 7, pie: "funciones asistidas por inteligencia artificial" },
  { valor: 2, pie: "aplicaciones: la profesional y la del paciente" },
];
---

<section class="cifras">
  <div class="contenedor cifras-grilla">
    {
      cifras.map((cifra) => (
        <div class="cifra revelar">
          <strong data-contar={cifra.valor}>{cifra.valor}</strong>
          <span>{cifra.pie}</span>
        </div>
      ))
    }
  </div>
</section>
