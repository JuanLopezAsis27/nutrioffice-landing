---
import Icono from "./Icono.astro";
import Tarjeta from "./Tarjeta.astro";

const funciones = [
  {
    icono: "sparkles",
    titulo: "Asistente analítico",
    texto:
      "Responde consultas sobre pacientes, planes, recetas y turnos leyendo la base de datos del consultorio con herramientas, no de memoria.",
  },
  {
    icono: "file-text",
    titulo: "Alta desde un documento",
    texto:
      "La historia clínica en PDF se interpreta y precarga la ficha del paciente junto con sus evoluciones. Releer el mismo documento no duplica registros.",
  },
  {
    icono: "file-spreadsheet",
    titulo: "Importación de planillas",
    texto:
      "Años de antropometrías en una hoja de cálculo, con una columna por consulta, quedan volcados en una tabla de revisión. Una fecha repetida no invalida el resto.",
  },
  {
    icono: "mic",
    titulo: "Grabación de la consulta",
    texto:
      "El audio se graba desde la ficha del turno y continúa grabándose mientras se navega por el sistema. Luego se transcribe y queda un resumen en la ficha.",
  },
  {
    icono: "bot",
    titulo: "Asistente del paciente",
    texto:
      "Dentro del portal, responde las dudas sobre el plan y las recetas con el tono y los límites que define el consultorio.",
  },
  {
    icono: "notebook-pen",
    titulo: "Instrucciones configurables",
    texto:
      "Los siete textos que guían al modelo se editan desde Configuración: terminología propia, títulos y forma de redactar un resumen.",
  },
];
---

<section class="seccion seccion-oscura" id="ia">
  <div class="brillo-ia" aria-hidden="true"></div>

  <div class="contenedor">
    <header class="encabezado-seccion revelar">
      <p class="etiqueta-seccion">Inteligencia artificial</p>
      <h2>La carga de datos, resuelta</h2>
      <p class="bajada-seccion">
        Siete funciones utilizan un modelo de lenguaje bajo una misma regla:
        <strong>la inteligencia artificial no guarda información por su cuenta</strong>.
        Interpreta, precarga el formulario y el profesional confirma.
      </p>
    </header>

    <div class="grilla-tarjetas grilla-tres" data-brillo>
      {
        funciones.map((funcion) => (
          <div class="revelar">
            <Tarjeta icono={funcion.icono} titulo={funcion.titulo} oscura>
              {funcion.texto}
            </Tarjeta>
          </div>
        ))
      }
    </div>

    <p class="nota-seccion revelar">
      <Icono nombre="lock" />
      Las funciones se activan con una clave propia de Anthropic, OpenAI u
      OpenRouter. Sin clave configurada permanecen desactivadas: el sistema no
      genera datos clínicos de demostración.
    </p>
  </div>
</section>

<style>
  .seccion-oscura {
    position: relative;
    overflow: hidden;
  }

  /* Dos resplandores muy suaves para que el bloque oscuro no sea un rectángulo
     plano. No hay imágenes: son dos gradientes. */
  .brillo-ia {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        60% 50% at 15% 0%,
        hsl(var(--primario) / 0.18),
        transparent 70%
      ),
      radial-gradient(
        50% 50% at 90% 100%,
        hsl(266 60% 55% / 0.14),
        transparent 70%
      );
    pointer-events: none;
  }

  .grilla-tarjetas > .revelar {
    display: flex;
  }

  .grilla-tarjetas > .revelar > :global(.tarjeta) {
    width: 100%;
  }
</style>
