---
import Tarjeta from "./Tarjeta.astro";

const plataformas = [
  {
    icono: "monitor",
    titulo: "Web",
    texto:
      "Funciona en cualquier navegador, con una interfaz pensada para el trabajo frente a una pantalla grande durante la consulta.",
  },
  {
    icono: "cloud-upload",
    titulo: "Instalable",
    texto:
      "Se instala en Windows, Mac, Android e iPhone con ícono y ventana propios, sin barra de direcciones. Es el mismo sitio: se actualiza sin intervención.",
  },
  {
    icono: "smartphone",
    titulo: "App Android",
    texto:
      "El portal del paciente en una aplicación nativa, con los permisos de salud necesarios para incorporar los datos del reloj.",
  },
];
---

<section class="seccion">
  <div class="contenedor">
    <header class="encabezado-seccion revelar">
      <p class="etiqueta-seccion">Disponibilidad</p>
      <h2>En la consulta y en el teléfono</h2>
    </header>

    <div class="grilla-tarjetas grilla-tres" data-brillo>
      {
        plataformas.map((plataforma) => (
          <div class="revelar">
            <Tarjeta icono={plataforma.icono} titulo={plataforma.titulo}>
              {plataforma.texto}
            </Tarjeta>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grilla-tarjetas > .revelar {
    display: flex;
  }

  .grilla-tarjetas > .revelar > :global(.tarjeta) {
    width: 100%;
  }
</style>
