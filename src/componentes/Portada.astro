---
import Icono from "./Icono.astro";
import MaquetaPanel from "./MaquetaPanel.astro";
---

<section class="portada">
  <div class="portada-fondo patron-puntos" aria-hidden="true"></div>
  <div class="portada-halo" aria-hidden="true"></div>

  <div class="contenedor portada-grilla">
    <div class="portada-texto">
      <p class="etiqueta">
        <Icono nombre="heart-pulse" />
        Gestión integral para consultorios de nutrición
      </p>

      <h1>
        El consultorio entero,<br />
        <span class="resaltado">en una sola app.</span>
      </h1>

      <p class="bajada">
        Pacientes, turnos, planes, composición corporal y el seguimiento del día
        a día. Con portal propio para el paciente, recordatorios que salen solos
        e inteligencia artificial que te saca de encima la carga de datos.
      </p>

      <div class="portada-botones">
        <a class="boton boton-primario boton-grande" href="#contacto">
          Pedir una demo
          <Icono nombre="arrow-right" />
        </a>
        <a class="boton boton-suave boton-grande" href="#pantallas">
          Ver las pantallas
        </a>
      </div>

      <ul class="portada-chips">
        <li><Icono nombre="monitor" /> Web</li>
        <li><Icono nombre="smartphone" /> Android</li>
        <li><Icono nombre="cloud-upload" /> Instalable (PWA)</li>
      </ul>
    </div>

    <div class="maqueta-marco revelar" data-inclinable aria-hidden="true">
      <MaquetaPanel />
    </div>
  </div>
</section>

<style>
  /* Un resplandor coral muy tenue detrás de la maqueta: despega la ventana del
     fondo sin agregar una imagen. */
  .portada-halo {
    position: absolute;
    top: -180px;
    right: -120px;
    width: 760px;
    height: 620px;
    background: radial-gradient(
      circle at 50% 50%,
      hsl(var(--primario) / 0.16),
      transparent 62%
    );
    pointer-events: none;
  }

  /* Mientras el cursor la inclina, la maqueta tiene que responder: los 0,5 s
     de reposo que trae del CSS general dejaban el movimiento arrastrado. */
  [data-inclinable] :global(.maqueta) {
    transition: transform 0.18s ease-out;
  }

  @media (max-width: 1040px) {
    .portada-halo {
      right: -240px;
      opacity: 0.7;
    }
  }
</style>
