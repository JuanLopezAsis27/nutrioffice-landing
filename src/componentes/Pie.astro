---
import Icono from "./Icono.astro";

const producto = [
  { href: "/#modulos", texto: "Funciones" },
  { href: "/#pantallas", texto: "Pantallas" },
  { href: "/#ia", texto: "Inteligencia artificial" },
  { href: "/#portal", texto: "Portal del paciente" },
  { href: "/#integraciones", texto: "Integraciones" },
  { href: "/#preguntas", texto: "Preguntas frecuentes" },
];

const legales = [
  { href: "/privacidad/", texto: "Política de privacidad" },
  { href: "/terminos/", texto: "Términos del servicio" },
];
---

<footer class="pie">
  <div class="contenedor pie-columnas">
    <div class="pie-marca">
      <a class="marca" href="/">
        <img src="/recursos/marca.svg" alt="" width="34" height="34" />
        <span>Nutri<b>Office</b></span>
      </a>
      <p>
        La gestión completa del consultorio de nutrición: pacientes, turnos,
        planes, composición corporal y el seguimiento del día a día.
      </p>
    </div>

    <nav aria-label="Producto">
      <h2>Producto</h2>
      <ul>
        {producto.map((enlace) => <li><a href={enlace.href}>{enlace.texto}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Legales">
      <h2>Legales</h2>
      <ul>
        {legales.map((enlace) => <li><a href={enlace.href}>{enlace.texto}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2>Contacto</h2>
      <ul>
        <li>
          <a href="mailto:hola@nutrioffice.app">
            <Icono nombre="mail" />
            hola@nutrioffice.app
          </a>
        </li>
        <li>
          <a href="/#contacto">
            <Icono nombre="calendar-days" />
            Pedir una demo
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="contenedor pie-legal">
    <p>© <span id="anio">2026</span> NutriOffice. Todos los derechos reservados.</p>
    <p class="pie-hecho">Hecho para licenciados en nutrición.</p>
  </div>
</footer>

<style>
  .pie {
    border-top: 1px solid hsl(var(--borde));
    background: hsl(var(--tarjeta) / 0.6);
  }

  .pie-columnas {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 40px;
  }

  .pie-marca p {
    max-width: 30rem;
    margin-top: 14px;
    color: hsl(var(--apagado));
    font-size: 14.5px;
  }

  h2 {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--texto));
  }

  ul {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: hsl(var(--apagado));
    font-size: 14.5px;
    transition: color 0.15s ease;
  }

  li a:hover {
    color: hsl(var(--primario));
  }

  .pie-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 20px;
    padding-bottom: 28px;
    border-top: 1px solid hsl(var(--borde));
    color: hsl(var(--apagado));
    font-size: 13px;
  }

  .pie-hecho {
    color: hsl(var(--apagado) / 0.8);
  }

  @media (max-width: 880px) {
    .pie-columnas {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .pie-marca {
      grid-column: 1 / -1;
    }
  }
</style>
