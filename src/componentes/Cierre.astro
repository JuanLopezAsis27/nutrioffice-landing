---
import Icono from "./Icono.astro";
---

<section class="cierre" id="contacto">
  <div class="cierre-fondo patron-puntos" aria-hidden="true"></div>

  <div class="contenedor cierre-caja revelar">
    <h2>Una demostración sobre datos reales</h2>
    <p>
      La demostración recorre el panel profesional, el portal del paciente y la
      migración de la planilla de antropometrías. Requiere treinta minutos.
    </p>

    <div class="cierre-botones">
      <a class="boton boton-primario boton-grande" href="mailto:hola@nutrioffice.com.ar">
        Solicitar una demostración
        <Icono nombre="arrow-right" />
      </a>
      <a class="boton boton-borde boton-grande" href="#pantallas">
        Las pantallas del sistema
      </a>
    </div>

    <p class="cierre-nota">
      <Icono nombre="clock" />
      Respuesta dentro del día hábil.
    </p>
  </div>
</section>

<style>
  .cierre-nota {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 22px;
    color: hsl(0 0% 100% / 0.8);
    font-size: 14px;
  }

  .cierre-nota :global(.ico) {
    width: 15px;
    height: 15px;
  }
</style>
