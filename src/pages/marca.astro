---
import Icono from "../componentes/Icono.astro";
import Marca from "../componentes/Marca.astro";
import Base from "../plantillas/Base.astro";

/**
 * Página de trabajo de la marca. No está enlazada desde ningún lado y lleva
 * noindex: existe para ver el isotipo en contexto —chiquito, sobre los dos
 * fondos, como ícono de app y al lado del nombre— y para dejar registrado de
 * dónde salió cada archivo.
 */
const tamanos = [56, 32, 24, 16];

const archivos = [
  {
    nombre: "marca.svg",
    ruta: "public/recursos/marca.svg",
    que: "El isotipo sobre un cuadrado oscuro redondeado.",
    donde: "Favicon del sitio y metaetiquetas sociales.",
  },
  {
    nombre: "Marca.astro",
    ruta: "src/componentes/Marca.astro",
    que: "El isotipo en línea, con la segunda tinta en currentColor.",
    donde: "Cabecera y pie: se adapta al tema claro u oscuro.",
  },
  {
    nombre: "nutrioffice.svg",
    ruta: "public/recursos/marcas/nutrioffice.svg",
    que: "El isotipo suelto con la tinta en blanco.",
    donde: "Fondos oscuros. Es la fuente de los íconos de la aplicación.",
  },
  {
    nombre: "nutrioffice-tinta-oscura.svg",
    ruta: "public/recursos/marcas/nutrioffice-tinta-oscura.svg",
    que: "El mismo, con la tinta en casi negro.",
    donde: "Fondos claros: membrete, PDF del plan, documentos impresos.",
  },
  {
    nombre: "nutrioffice-simple.svg",
    ruta: "public/recursos/marcas/nutrioffice-simple.svg",
    que: "Solo el anillo y la manzana, con trazo más grueso.",
    donde: "Por debajo de 32 píxeles, donde la pesa se empasta.",
  },
];

/** Lo que se probó antes de que llegara la marca definitiva. */
const descartadas = [
  { id: "manzana", nombre: "Manzana con flecha de progreso" },
  { id: "plato", nombre: "El método del plato" },
  { id: "hoja", nombre: "Hoja geométrica" },
  { id: "pulso", nombre: "El latido en un círculo" },
  { id: "anillo", nombre: "Anillo de progreso" },
  { id: "monograma", nombre: "Monograma N" },
  { id: "tazon", nombre: "Bol con brote" },
];
---

<Base
  titulo="La marca — NutriOffice"
  descripcion="El isotipo de NutriOffice en contexto, sus variantes y dónde se usa cada archivo."
  compacta
  oculta
>
  <section class="encabezado">
    <div class="fondo patron-puntos" aria-hidden="true"></div>
    <div class="contenedor">
      <p class="etiqueta">
        <Icono nombre="compass" />
        Documento de trabajo
      </p>
      <h1>La marca</h1>
      <p class="entrada">
        Anillo, manzana y pesa: el isotipo recoge la nutrición y el deporte, que
        son las dos mitades del consultorio. Está redibujado en vector a partir
        de la lámina original, que traía el símbolo como imagen incrustada.
      </p>
      <p class="nota">
        <Icono nombre="circle-help" />
        Esta página no está enlazada desde el sitio y lleva <code>noindex</code>.
      </p>
    </div>
  </section>

  <div class="contenedor cuerpo">
    <section class="bloque">
      <h2>Las dos tintas</h2>
      <p>
        El <strong>coral</strong> es fijo: el anillo grueso, la manzana y la
        hoja. La <strong>segunda tinta</strong> —el anillo fino exterior y la
        pesa— se adapta al fondo: casi negra sobre claro, blanca sobre oscuro.
        En el sitio eso se resuelve con <code>currentColor</code>, y por eso la
        marca va en línea y no como <code>&lt;img&gt;</code>.
      </p>

      <div class="fondos">
        <div class="panel oscuro">
          <span class="rotulo">Sobre oscuro</span>
          <div class="muestras">
            {tamanos.map((lado) => <Marca ancho={Math.round(lado * 1.3)} />)}
          </div>
          <div class="conjunto"><Marca ancho={44} /><span>Nutri<b>Office</b></span></div>
        </div>

        <div class="panel claro">
          <span class="rotulo">Sobre claro</span>
          <div class="muestras">
            {tamanos.map((lado) => <Marca ancho={Math.round(lado * 1.3)} />)}
          </div>
          <div class="conjunto"><Marca ancho={44} /><span>Nutri<b>Office</b></span></div>
        </div>
      </div>
    </section>

    <section class="bloque">
      <h2>Los archivos y dónde va cada uno</h2>
      <table>
        <thead>
          <tr><th>Archivo</th><th>Qué es</th><th>Dónde se usa</th></tr>
        </thead>
        <tbody>
          {
            archivos.map((archivo) => (
              <tr>
                <td><code>{archivo.nombre}</code></td>
                <td>{archivo.que}</td>
                <td>{archivo.donde}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="pie-tabla">
        Los íconos de la aplicación salen de <code>nutrioffice.svg</code>,
        copiado en <code>nutricionista-app/assets/marca/</code>. Los genera
        <code>scripts/generar-iconos-pwa.mjs</code>: marca sobre cuadrado
        oscuro, que es la versión oscura de la lámina. Sobre coral no
        funcionaría, porque el anillo y la manzana también son corales.
      </p>
    </section>

    <section class="bloque">
      <h2>Cómo está dibujada</h2>
      <ul>
        <li>
          La lámina original es un SVG de 3,8 MB con el símbolo adentro como
          <strong>PNG incrustado</strong>, no como vector. Lo que hay acá es un
          redibujo: se midió el bitmap pieza por pieza —radios, grosores,
          alturas de los discos— y se reconstruyó con círculos, rectángulos y
          curvas.
        </li>
        <li>
          El <strong>anillo fino son dos arcos</strong>, no un círculo: en la
          marca original queda interrumpido donde pasa la pesa, y ese corte es
          parte del dibujo.
        </li>
        <li>
          La <strong>pesa va por encima</strong> de los anillos: los cruza en
          lugar de esconderse detrás.
        </li>
        <li>
          La manzana es una silueta propia. La de la biblioteca de íconos es un
          contorno y, rellena, deja una muesca superior mucho más profunda que
          la de la marca.
        </li>
      </ul>
    </section>

    <section class="bloque">
      <h2>Lo que se probó antes</h2>
      <p>
        Propuestas anteriores, previas a que llegara la marca definitiva. Se
        conservan en <code>public/recursos/marcas/</code> como registro.
      </p>
      <div class="descartadas">
        {
          descartadas.map((propuesta) => (
            <figure>
              <img
                src={`/recursos/marcas/${propuesta.id}.svg`}
                alt={`Propuesta descartada: ${propuesta.nombre}`}
                width="46"
                height="46"
              />
              <figcaption>{propuesta.nombre}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .encabezado {
    position: relative;
    padding: 56px 0 40px;
    border-bottom: 1px solid hsl(var(--borde));
    overflow: hidden;
  }

  .fondo {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(80% 90% at 20% 0%, #000, transparent 70%);
    -webkit-mask-image: radial-gradient(80% 90% at 20% 0%, #000, transparent 70%);
    pointer-events: none;
  }

  .encabezado > .contenedor {
    position: relative;
  }

  .encabezado h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: 14px;
  }

  .entrada {
    max-width: 62ch;
    color: hsl(var(--apagado));
    font-size: 1.05rem;
  }

  .nota {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 10px 16px;
    border: 1px solid hsl(var(--borde));
    border-radius: var(--radio);
    background: hsl(var(--suave) / 0.5);
    color: hsl(var(--apagado));
    font-size: 14px;
  }

  .nota :global(.ico) {
    width: 16px;
    height: 16px;
    color: hsl(var(--primario));
  }

  .cuerpo {
    display: grid;
    gap: 44px;
    max-width: 880px;
    padding-top: 44px;
    padding-bottom: 80px;
  }

  h2 {
    margin: 0 0 14px;
    font-size: 1.4rem;
  }

  .bloque p {
    margin: 0 0 18px;
    color: hsl(var(--apagado));
    line-height: 1.7;
  }

  .bloque strong {
    color: hsl(var(--texto));
  }

  /* ----------------------------- los fondos ----------------------------- */

  .fondos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .panel {
    padding: 22px;
    border: 1px solid hsl(var(--borde));
    border-radius: var(--radio-grande);
  }

  /* Los dos paneles fuerzan su color de texto, que es de donde la marca saca
     su segunda tinta: así se ve cómo queda en cada tema sin cambiar el sitio. */
  .panel.oscuro {
    background: #161618;
    color: #f5f5f5;
  }

  .panel.claro {
    background: #f4f4f6;
    color: #17171a;
  }

  .rotulo {
    display: block;
    margin-bottom: 16px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .muestras {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 60px;
  }

  .panel :global(.isotipo) {
    color: inherit;
  }

  .conjunto {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid currentColor;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .conjunto b {
    color: hsl(var(--primario));
    font-weight: 800;
  }

  /* ------------------------------- tabla ------------------------------- */

  table {
    width: 100%;
    margin: 0 0 14px;
    border-collapse: collapse;
    font-size: 14.5px;
  }

  th,
  td {
    padding: 10px 12px;
    border: 1px solid hsl(var(--borde));
    text-align: left;
    vertical-align: top;
  }

  th {
    background: hsl(var(--suave) / 0.6);
    font-size: 12.5px;
    letter-spacing: 0.02em;
  }

  td {
    color: hsl(var(--apagado));
  }

  .pie-tabla {
    font-size: 14.5px;
  }

  code {
    padding: 2px 6px;
    border: 1px solid hsl(var(--borde));
    border-radius: 6px;
    background: hsl(var(--suave) / 0.7);
    font-size: 0.9em;
  }

  /* ------------------------------- listas ------------------------------- */

  .bloque ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bloque li {
    position: relative;
    padding-left: 22px;
    color: hsl(var(--apagado));
    line-height: 1.7;
  }

  .bloque li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 12px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: hsl(var(--primario));
  }

  /* ---------------------------- descartadas ---------------------------- */

  .descartadas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  figure {
    display: grid;
    justify-items: center;
    gap: 8px;
    width: 120px;
    margin: 0;
    padding: 16px 10px;
    border: 1px solid hsl(var(--borde));
    border-radius: var(--radio);
    background: hsl(var(--tarjeta));
    opacity: 0.65;
  }

  figcaption {
    color: hsl(var(--apagado));
    font-size: 11.5px;
    text-align: center;
    line-height: 1.3;
  }

  @media (max-width: 760px) {
    .fondos {
      grid-template-columns: 1fr;
    }

    table {
      font-size: 13px;
    }
  }
</style>
